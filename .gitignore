# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

onsite_headless_prototype
# Raw scanner output. secsuite-run-40.pdf carries the leaked Braintree and
# Elasticsearch keys in its text, so committing it would copy the leak into this
# repository history too. Keep scans local; the remediation report is committed.
docs/security_audit/secsuite-run-*.pdf
